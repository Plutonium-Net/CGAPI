# runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# comma separated list of allowed browser origins, or * for any
CORS_ORIGIN=*

# writable directory for the pooled account file (mount a volume in containers)
DATA_DIR=./data

# account pool
POOL_SIZE=5
POOL_MAX_AGE_HOURS=12

# upstream behaviour
REGION_CODE=US
REQUEST_TIMEOUT_MS=20000
QUEUE_TIMEOUT_MS=600000
MAIL_TIMEOUT_MS=90000

# hostnames the signaling proxy may connect to (leading dot = suffix match)
ALLOWED_SIGNAL_HOSTS=.ludiumlab.com
